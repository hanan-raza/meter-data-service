@MeterDataService.Api_HostAddress = http://localhost:5227

### Queue a CSV file for import (202 Accepted + Location header)
POST {{MeterDataService.Api_HostAddress}}/api/import
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="marketLocationId"

41373559241
--boundary
Content-Disposition: form-data; name="file"; filename="household-one-day.csv"
Content-Type: text/csv

< ../../docs/samples/household-one-day.csv
--boundary--

### Poll the job status (replace the id with the one from the Location header)
GET {{MeterDataService.Api_HostAddress}}/api/import/00000000-0000-0000-0000-000000000000
Accept: application/json

### Invalid MaLo-ID (wrong check digit) → 400
POST {{MeterDataService.Api_HostAddress}}/api/import
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="marketLocationId"

41373559242
--boundary
Content-Disposition: form-data; name="file"; filename="household-one-day.csv"
Content-Type: text/csv

< ../../docs/samples/household-one-day.csv
--boundary--
